# Generic container image (deploy/container/Dockerfile)
!deploy/container/**
!services/**
!schemas/**
services/**/__pycache__/
!apps/builder-ui/**
apps/builder-ui/node_modules/
apps/builder-ui/dist/
apps/builder-ui/test-results/
apps/builder-ui/playwright-report/
