# Run python3 scripts/dev_setup.py to create .env with random local credentials.
MCP_FACTORY_RUNTIME_IMAGE=christopheraburns/mcp-factory-runtime:0.1.1
POSTGRES_PASSWORD=replace-with-a-random-password
FACTORY_ADMINISTRATOR_TOKEN=replace-with-at-least-32-random-characters
FACTORY_AUTHOR_TOKEN=replace-with-at-least-32-random-characters
FACTORY_PUBLISHER_TOKEN=replace-with-at-least-32-random-characters
FACTORY_VIEWER_TOKEN=replace-with-at-least-32-random-characters
FACTORY_MCP_TOKEN=replace-with-at-least-32-random-characters
FACTORY_ALLOWED_API_ORIGINS=http://mock-api:8080
FACTORY_BROWSER_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
# manual records deployment intent; cloudera-ai manages the Server application through the Workbench API v2
# (FACTORY_CAI_DOMAIN, FACTORY_CAI_API_KEY, FACTORY_CAI_PROJECT_ID, FACTORY_CAI_RUNTIME_IDENTIFIER; inside Workbench the
# launchers fill these from CDSW_DOMAIN, CDSW_APIV2_KEY, CDSW_PROJECT_ID and MCP_FACTORY_RUNTIME_IMAGE); cloudera-bridge calls the bridge below.
# The services themselves read only FACTORY_* variables and DATABASE_URL; see deploy/container for running without Workbench.
FACTORY_DEPLOYMENT_PROVIDER=manual
# docker provider: mount /var/run/docker.sock into the Builder and name the image Server containers run.
# FACTORY_SERVER_IMAGE=daedalus:local
# FACTORY_DOCKER_NETWORK=daedalus_default
# FACTORY_DOCKER_PUBLISH=true
# FACTORY_DOCKER_HOST_NAME=localhost
# kubernetes provider: in-cluster service account by default (see deploy/kubernetes/builder.yaml).
# FACTORY_K8S_NAMESPACE=mcp
# FACTORY_K8S_CPU=500m
# FACTORY_K8S_MEMORY=1Gi
# FACTORY_ENDPOINT_TEMPLATE=https://{name}.mcp.example.com/mcp
# FACTORY_CLOUDERA_API_BASE_URL=https://deployment-bridge.example
# FACTORY_CLOUDERA_PROJECT_ID=your-project-id
# FACTORY_CLOUDERA_API_TOKEN=store-in-workbench-secret-management

# Seed tool packs switched on at startup (comma-separated; an administrator's toggle in the Builder overrides this per pack).
# FACTORY_PACKS_ENABLED=webhdfs_admin
