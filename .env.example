# Run python3 scripts/dev_setup.py to create .env with random local credentials.
MCP_FACTORY_RUNTIME_IMAGE=christopheraburns/mcp-factory-runtime:0.1.1
POSTGRES_PASSWORD=replace-with-a-random-password
FACTORY_ADMINISTRATOR_TOKEN=replace-with-at-least-32-random-characters
FACTORY_AUTHOR_TOKEN=replace-with-at-least-32-random-characters
FACTORY_PUBLISHER_TOKEN=replace-with-at-least-32-random-characters
FACTORY_VIEWER_TOKEN=replace-with-at-least-32-random-characters
FACTORY_MCP_TOKEN=replace-with-at-least-32-random-characters
FACTORY_ALLOWED_API_ORIGINS=http://mock-api:8080
FACTORY_BROWSER_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
# manual records deployment intent; cloudera-bridge calls the versioned deployment bridge below.
FACTORY_DEPLOYMENT_PROVIDER=manual
# FACTORY_CLOUDERA_API_BASE_URL=https://deployment-bridge.example
# FACTORY_CLOUDERA_PROJECT_ID=your-project-id
# FACTORY_CLOUDERA_API_TOKEN=store-in-workbench-secret-management
